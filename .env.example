# First-run default for the GPU server URL. Change it later from the Settings page.
GPU_API_BASE_URL=

# Bitdeer AI key. Secret: never shown in the UI, sent only to api-inference.bitdeer.ai.
BITDEEP_API_KEY=

# First-run default for the LLM base URL (Bitdeer's OpenAI-compatible endpoint).
BITDEEP_BASE_URL=

# Host port the frontend is published on (127.0.0.1 only). Defaults to 5480 if unset.
APP_PORT=

# YouTube publishing (YouTube_publish_phases.md). Secrets: never shown in the UI or logs.
# OAuth client id of the Google Cloud project (Web application).
YOUTUBE_CLIENT_ID=

# OAuth client secret of the same client.
YOUTUBE_CLIENT_SECRET=

# The redirect address registered for the client, for example
# http://127.0.0.1:5480/api/youtube/oauth/callback. Open the app at the same host when connecting.
YOUTUBE_REDIRECT_URI=

# Key the stored channel tokens are encrypted with (a Fernet key). Make one with:
#   openssl rand -base64 32 | tr '+/' '-_'
# Changing it makes every connected channel need reconnecting.
YOUTUBE_TOKEN_KEY=

# Files folder on the Mac (STOR-001). By default media and temporary files live in the Docker
# volume. To keep them in a folder you can open in Finder, create the folder once, with its media
# folder and an empty marker file, and set both lines below (use an absolute path, not ~):
#   mkdir -p /Users/<you>/VisioStudioData/media && touch /Users/<you>/VisioStudioData/.visio-studio-files
# The database always stays in the Docker volume. Do not rename, move or delete files in this
# folder from Finder: the database points at their exact names. Changing these lines does not
# copy existing media; that is a separate, careful step (STOR-002).
# COMPOSE_FILE=docker-compose.yml:docker-compose.files.yml
# VISIO_FILES_DIR=/Users/<you>/VisioStudioData
